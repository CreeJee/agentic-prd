{
  "name": "@agentic-prd/dev-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Vite dev-server sidecar for reading @agentic-prd/widget comments and specs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CreeJee/agentic-prd.git",
    "directory": "packages/dev-plugin"
  },
  "homepage": "https://github.com/CreeJee/agentic-prd#readme",
  "author": "CreeJee",
  "keywords": [
    "comment",
    "annotation",
    "widget",
    "react",
    "vite-plugin",
    "claude-code",
    "agentic"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo -p ./tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm biome check . --diagnostic-level=error --max-diagnostics=200"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsdown": "^0.22.3",
    "vite": "^8.1.3",
    "vitest": "4.1.9"
  }
}
